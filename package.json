{
  "name": "citemyshi",
  "version": "1.0.0",
  "description": "Free citation generator — a MyBib-style app",
  "scripts": {
    "start": "node server/index.js",
    "setup": "node scripts/fetch-styles.js && node scripts/build-words.js && node scripts/build-vendor.js",
    "dev": "node --watch server/index.js",
    "vendor": "node scripts/build-vendor.js",
    "test": "node --test tests/*.test.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-citemyshi 'node --test tests/rules.emu.mjs'"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@citation-js/core": "^0.9.0",
    "@citation-js/plugin-bibtex": "^0.9.0",
    "@citation-js/plugin-csl": "^0.9.0",
    "@citation-js/plugin-ris": "^0.9.0",
    "cheerio": "^1.2.0",
    "compression": "^1.8.2",
    "docx": "^9.14.0",
    "express": "^5.3.0",
    "undici": "^6.29.1"
  },
  "engines": {
    "node": ">=20.18"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.10.0"
  }
}
